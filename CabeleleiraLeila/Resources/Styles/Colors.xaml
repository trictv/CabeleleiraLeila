<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="Primary">#6C8EAD</Color>
    <Color x:Key="PrimaryDark">#4F718F</Color>
    <Color x:Key="Secondary">#607D8B</Color>
    <Color x:Key="Tertiary">#4F718F</Color>

    <Color x:Key="BackgroundLight">#F5F8FA</Color>
    <Color x:Key="BackgroundDark">#121212</Color>

    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#1E1E1E</Color>

    <Color x:Key="TextPrimaryLight">#263238</Color>
    <Color x:Key="TextPrimaryDark">#E0E0E0</Color>

    <Color x:Key="TextSecondaryLight">#607D8B</Color>
    <Color x:Key="TextSecondaryDark">#90A4AE</Color>

    <Color x:Key="Success">#66BB6A</Color>
    <Color x:Key="Error">#EF5350</Color>
    <Color x:Key="Alert">#FFA726</Color>

    <Color x:Key="OnPrimary">#FFFFFF</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>

</ResourceDictionary>