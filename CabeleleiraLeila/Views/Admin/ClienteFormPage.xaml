<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:material="clr-namespace:UraniumUI.Material.Controls;assembly=UraniumUI.Material"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="CabeleleiraLeila.Views.Admin.ClienteFormPage"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="24">

            
            <Border Padding="20" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                <VerticalStackLayout Spacing="18">

                    <material:TextField Title="Nome Completo" Text="{Binding ClienteAtual.Nome}" />
                    <material:TextField Title="E-mail" Text="{Binding ClienteAtual.Email}" Keyboard="Email" />

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15">

                        <material:TextField Grid.Column="0" Title="Telefone" Text="{Binding ClienteAtual.Telefone}" Keyboard="Telephone">
                            <material:TextField.EntryBehaviors>
                                <toolkit:MaskedBehavior Mask="(XX) XXXXX-XXXX" />
                            </material:TextField.EntryBehaviors>
                        </material:TextField>

                        <material:TextField Grid.Column="1" Title="CPF" Text="{Binding ClienteAtual.Cpf}" Keyboard="Numeric">
                            <material:TextField.EntryBehaviors>
                                <toolkit:MaskedBehavior Mask="XXX.XXX.XXX-XX" />
                            </material:TextField.EntryBehaviors>
                        </material:TextField>

                    </Grid>

                    
                    <material:DatePickerField Title="Data de Nascimento" 
                                              Date="{Binding ClienteAtual.DataNascimentoObj}" 
                                              Format="dd/MM/yyyy" />

                    <material:TextField Title="Observações (Alergias, etc)" Text="{Binding ClienteAtual.Observacoes}" />

                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <Label Text="Cliente Ativo?" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding ClienteAtual.IsAtivo}" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            
            <VerticalStackLayout IsVisible="{Binding IsEditando}" Spacing="10">
                <Label Text="Histórico de Agendamentos" FontFamily="OpenSansSemibold" FontSize="16" />

                <Label Text="Nenhum agendamento encontrado." IsVisible="{Binding SemHistorico}" FontSize="13" TextColor="{StaticResource TextSecondaryLight}"/>

                <CollectionView ItemsSource="{Binding Historico}" HeightRequest="200">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10" Margin="0,0,0,8" StrokeThickness="1" Stroke="{StaticResource TextSecondaryLight}">
                                <Grid ColumnDefinitions="*, Auto">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="{Binding DataFormatada}" FontFamily="OpenSansSemibold" FontSize="14" />
                                        <Label Text="{Binding Status}" FontSize="12" TextColor="{StaticResource Primary}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding ValorTotal, StringFormat='R$ {0:F2}'}" VerticalOptions="Center" FontFamily="OpenSansSemibold" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />

            <VerticalStackLayout Spacing="10">
                <Button Text="Salvar Cliente" Command="{Binding SalvarCommand}" IsEnabled="{Binding IsNotBusy}" />
                <Button Text="Cancelar" Command="{Binding CancelarCommand}" BackgroundColor="{StaticResource Alert}" IsEnabled="{Binding IsNotBusy}" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>